# -----------------------------------------------------------------------------
# Copy to .env and fill values for local dev. Never commit .env.
# -----------------------------------------------------------------------------

# --- Database (local: docker compose; prod: Neon) ---
# Local docker default matches docker-compose.yml
DATABASE_URL="postgresql://medium:medium@localhost:5432/medium_alt?schema=public"
# For Neon in prod, DATABASE_URL uses the pooled connection and DIRECT_URL uses the direct one
DIRECT_URL="postgresql://medium:medium@localhost:5432/medium_alt?schema=public"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Email (dev: mailpit / prod: Resend) ---
# Dev uses SMTP → Mailpit on localhost:1025 (see docker-compose.yml)
EMAIL_FROM="Medium-Alt <no-reply@medium-alt.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# Prod (Resend). Leave empty in dev.
RESEND_API_KEY=""

# --- Uploads (UploadThing) ---
UPLOADTHING_TOKEN=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Testing / E2E overrides ---
# Playwright reads these; leave empty locally to use defaults above.
E2E_BASE_URL=""
E2E_MAILPIT_URL="http://localhost:8025"
