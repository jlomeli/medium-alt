// Medium-Alt Prisma schema.
//
// This is the v0 shape: enough Auth.js v5 models to make migrations exist
// end-to-end before we build the auth feature. The Article / Tag / Follow / Clap
// / Comment models land alongside their respective feature specs — see
// docs/specs/*.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js v5 required models
// https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  articles            Article[]
  uploads             Upload[]
  // Follow — see docs/specs/follow.md.
  // `following` = rows where this user is the follower (doing the following).
  // `followers` = rows where this user is being followed.
  following           Follow[]             @relation("FollowFollower")
  followers           Follow[]             @relation("FollowFollowing")
  // Claps — see docs/specs/claps.md. One row per (userId, articleId)
  // pair, aggregated count 1–50. No inverse "who clapped for X"
  // surface in v1; the composite PK on Clap is enough for both the
  // read paths (viewer-state lookup, article aggregate).
  claps               Clap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Articles — see docs/specs/articles-crud.md. Body is plain text in
// slice 4a; migrates to Json for Tiptap in 4b.
model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String?
  body          Json      // Tiptap ProseMirror document. Zod-validated on write (see lib/validation/article.ts).
  // Cover image (slice 4c): both nullable. `coverImageAlt` is decorative
  // when null on the read view (`alt=""`), per the spec's a11y decision.
  coverImageUrl String?
  coverImageAlt String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Tags — see docs/specs/tags-feed.md. Prisma-implicit many-to-many
  // (managed `_ArticleToTag` join). No per-association metadata is
  // needed today; if a slice ever wants "who tagged this / when", we
  // migrate to an explicit join model.
  tags          Tag[]
  // Claps — see docs/specs/claps.md.
  claps         Clap[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authorId])
  // Composite index that covers the feed's `ORDER BY publishedAt DESC, id DESC`
  // with a `published = true` filter — the `id` tiebreaker keeps cursor
  // pagination stable when two articles publish in the same millisecond.
  // See docs/specs/tags-feed.md § Pagination.
  @@index([published, publishedAt, id])
}

// Tags — see docs/specs/tags-feed.md.
//
// `slug` is the storage / lookup key (normalised, unique). `name` is
// the trimmed original the author typed; first writer wins if two
// authors capitalise differently ("Testing" vs. "testing").
model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]

  createdAt DateTime @default(now())

  @@index([slug])
}

// Uploads (slice 4c). One row per successful POST /api/uploadthing —
// records who uploaded each file so DELETE /api/articles/{slug}'s
// best-effort file-cascade can filter keys to those the deleter owns.
// Without this, an author could copy another user's public UploadThing
// URL into their own article and, on delete, nuke the original owner's
// file. See docs/specs/articles-images.md § Delete-cascade.
model Upload {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Follows — see docs/specs/follow.md.
//
// Explicit join with a composite primary key so `POST /follow` is a
// natural upsert (no findFirst round-trip) and `createdAt` lands for
// free. `followerId` = the user doing the following; `followingId` =
// the user being followed. Deletes cascade in both directions so a
// deleted user's incoming and outgoing edges disappear cleanly.
//
// The two indexes match the two read patterns:
//   - `followerId` → "who does X follow?" (Your Feed).
//   - `followingId` → future follower-list page.
model Follow {
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Claps — see docs/specs/claps.md.
//
// One row per (userId, articleId) pair with an aggregate `count` in
// [1, 50]. The composite primary key gives natural upsert idempotency
// for `POST /api/articles/{slug}/claps` (no findFirst round-trip), and
// avoids the row amplification a per-clap event table would produce on
// a rapid tap. Cascade in both directions so a deleted user's or a
// deleted article's claps vanish cleanly.
//
// Index on `articleId` covers both "SUM(count) for this article"
// (single article read) and "SUM(count) GROUP BY articleId" (feed
// enrichment via `sumClapsForArticles`).
model Clap {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, articleId])
  @@index([articleId])
}

// Password-reset flow — see docs/specs/auth.md. `tokenHash` is sha256(raw);
// the raw token only ever exists in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
