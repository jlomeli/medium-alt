// Medium-Alt Prisma schema.
//
// This is the v0 shape: enough Auth.js v5 models to make migrations exist
// end-to-end before we build the auth feature. The Article / Tag / Follow / Clap
// / Comment models land alongside their respective feature specs — see
// docs/specs/*.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js v5 required models
// https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  bio           String?

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  articles            Article[]
  uploads             Upload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Articles — see docs/specs/articles-crud.md. Body is plain text in
// slice 4a; migrates to Json for Tiptap in 4b.
model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String?
  body          Json      // Tiptap ProseMirror document. Zod-validated on write (see lib/validation/article.ts).
  // Cover image (slice 4c): both nullable. `coverImageAlt` is decorative
  // when null on the read view (`alt=""`), per the spec's a11y decision.
  coverImageUrl String?
  coverImageAlt String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authorId])
  @@index([published, publishedAt])
}

// Uploads (slice 4c). One row per successful POST /api/uploadthing —
// records who uploaded each file so DELETE /api/articles/{slug}'s
// best-effort file-cascade can filter keys to those the deleter owns.
// Without this, an author could copy another user's public UploadThing
// URL into their own article and, on delete, nuke the original owner's
// file. See docs/specs/articles-images.md § Delete-cascade.
model Upload {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Password-reset flow — see docs/specs/auth.md. `tokenHash` is sha256(raw);
// the raw token only ever exists in the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
